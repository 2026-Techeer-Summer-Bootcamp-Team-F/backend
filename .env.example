# ===== 백엔드 .env (복사 → .env, 값 채우기. 실제 .env 는 커밋/노션 금지) =====
# 💡 대부분 기본값으로 개발 가능(AUTH_MODE=mock + 키 비움 = 비밀 없이 오프라인 동작).

# 인증
AUTH_MODE=mock                                   # mock(dev-login) | github(OAuth)
JWT_SECRET=change-me-to-a-long-random-min-32-bytes
TOKEN_ENC_KEY=                                    # 비우면 평문(PoC). 실 OAuth 시 Fernet 키 권장(cryptography.fernet.Fernet.generate_key())

# DB — 비우면 compose가 로컬 postgres(db 컨테이너) 사용.
# 팀 공유 DB(Neon/RDS)를 쓰려면 아래에 그 연결주소를 넣으면 compose가 그걸 사용(${DATABASE_URL}).
#   예) postgresql+psycopg://user:pw@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://redteam:redteam@localhost:5432/redteam

# GitHub OAuth (AUTH_MODE=github 일 때만)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
FRONTEND_URL=http://localhost:5173

# 공격자 LLM (비우면 결정론적 변이만)
ANTHROPIC_API_KEY=
ATTACKER_MODEL=claude-haiku-4-5-20251001

# 관측성 Langfuse (LLM 트레이싱) — 비우면 비활성(no-op). cloud.langfuse.com 무료(Hobby).
# 마스킹 기본 ON: 프롬프트/표적응답 원문은 안 보내고 지연·토큰·비용·플로우만 전송.
# LANGFUSE_HOST 는 가입 시 고른 리전 주소(JP: https://jp.cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Redis (result backend·rate-limit·캐시) — compose가 자동주입
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (Celery 메시지 브로커) — compose가 자동주입
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# 스캔 전체 시간 제한(초) — 우아한 마감(#139). 초과 시 진행 중 공격 1건만 마치고 정상 종료(부분).
# Celery soft/hard time_limit은 이 값에서 +180/+240으로 파생된다.
SCAN_DEADLINE_SECONDS=600
